{
  "name": "fwa",
  "version": "2.0.7",
  "description": "Compiled TypeScript test runner for Node.js",
  "keywords": [
    "test",
    "testing",
    "test-runner",
    "node-test",
    "typescript",
    "compiled-tests",
    "test-discovery",
    "stale-tests",
    "cli"
  ],
  "author": "Stanislav Potemkin <woodger@ya.ru>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git@github.com/woodger/fwa.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fwa": "dist/bin.js"
  },
  "scripts": {
